    background-size: 100% 100%; background-attachment: fixed; }
body { background: transparent !important; }
body::before, body::after, html::before {
    content: ""; position: fixed; z-index: -1; pointer-events: none; will-change: transform;
    width: 90vmax; height: 90vmax; border-radius: 50%;
}
body::before {
    left: -35vmax; bottom: -40vmax;
    background: radial-gradient(circle, rgba(110, 60, 230, 0.75), transparent 62%);
    animation: vanta-drift-a 30s ease-in-out infinite alternate;
}
body::after {
    right: -30vmax; bottom: -35vmax;
    background: radial-gradient(circle, rgba(150, 70, 220, 0.62), transparent 62%);
    animation: vanta-drift-b 38s ease-in-out infinite alternate;
}
html::before {
    left: 5vw; top: -50vmax;
    background: radial-gradient(circle, rgba(70, 90, 235, 0.50), transparent 62%);
    animation: vanta-drift-c 46s ease-in-out infinite alternate;
}
/* The floating dust from the installer: little purple specks that twinkle and slowly rise. */
html::after {
    content: ""; position: fixed; left: 0; top: 0; width: 100vw; height: 200vh; z-index: -1; pointer-events: none; will-change: transform, opacity;
    background-image:
        radial-gradient(circle at 45.2% 56.0%, rgba(219,188,255,.85) 0, rgba(219,188,255,.85) 2.0px, rgba(219,188,255,.16) 2.6px, transparent 10.1px),
        radial-gradient(circle at 50.8% 58.7%, rgba(222,190,255,.85) 0, rgba(222,190,255,.85) 0.9px, rgba(222,190,255,.16) 1.5px, transparent 4.7px),
        radial-gradient(circle at 63.0% 79.3%, rgba(209,169,255,.85) 0, rgba(209,169,255,.85) 0.8px, rgba(209,169,255,.16) 1.4px, transparent 4.0px),
        radial-gradient(circle at 9.1% 81.0%, rgba(192,198,255,.85) 0, rgba(192,198,255,.85) 1.7px, rgba(192,198,255,.16) 2.3px, transparent 8.4px),
        radial-gradient(circle at 98.2% 96.5%, rgba(229,201,255,.85) 0, rgba(229,201,255,.85) 1.6px, rgba(229,201,255,.16) 2.2px, transparent 8.1px),
        radial-gradient(circle at 15.7% 1.5%, rgba(193,162,255,.85) 0, rgba(193,162,255,.85) 1.4px, rgba(193,162,255,.16) 2.0px, transparent 7.2px),
        radial-gradient(circle at 19.0% 24.2%, rgba(219,180,255,.85) 0, rgba(219,180,255,.85) 0.7px, rgba(219,180,255,.16) 1.3px, transparent 3.6px),
        radial-gradient(circle at 44.1% 84.2%, rgba(230,178,255,.85) 0, rgba(230,178,255,.85) 1.4px, rgba(230,178,255,.16) 2.0px, transparent 7.1px),
        radial-gradient(circle at 50.0% 66.2%, rgba(207,186,255,.85) 0, rgba(207,186,255,.85) 1.3px, rgba(207,186,255,.16) 1.9px, transparent 6.7px),
        radial-gradient(circle at 99.8% 99.6%, rgba(235,176,255,.85) 0, rgba(235,176,255,.85) 1.9px, rgba(235,176,255,.16) 2.5px, transparent 9.5px),
        radial-gradient(circle at 31.5% 23.0%, rgba(194,196,255,.85) 0, rgba(194,196,255,.85) 1.1px, rgba(194,196,255,.16) 1.7px, transparent 5.5px),
        radial-gradient(circle at 76.6% 40.0%, rgba(214,164,255,.85) 0, rgba(214,164,255,.85) 1.9px, rgba(214,164,255,.16) 2.5px, transparent 9.5px),
        radial-gradient(circle at 95.8% 84.7%, rgba(203,219,255,.85) 0, rgba(203,219,255,.85) 0.7px, rgba(203,219,255,.16) 1.3px, transparent 3.4px),
        radial-gradient(circle at 91.0% 47.0%, rgba(215,186,255,.85) 0, rgba(215,186,255,.85) 2.1px, rgba(215,186,255,.16) 2.7px, transparent 10.5px),
        radial-gradient(circle at 7.3% 62.9%, rgba(207,181,255,.85) 0, rgba(207,181,255,.85) 1.8px, rgba(207,181,255,.16) 2.4px, transparent 9.0px),
        radial-gradient(circle at 8.7% 33.3%, rgba(238,219,255,.85) 0, rgba(238,219,255,.85) 2.0px, rgba(238,219,255,.16) 2.6px, transparent 10.4px),
        radial-gradient(circle at 11.8% 24.6%, rgba(193,189,255,.85) 0, rgba(193,189,255,.85) 0.8px, rgba(193,189,255,.16) 1.4px, transparent 4.1px),
