        radial-gradient(circle at 73.9% 94.0%, rgba(214,216,255,.85) 0, rgba(214,216,255,.85) 0.9px, rgba(214,216,255,.16) 1.5px, transparent 4.8px),
        radial-gradient(circle at 48.3% 7.8%, rgba(196,162,255,.85) 0, rgba(196,162,255,.85) 0.7px, rgba(196,162,255,.16) 1.3px, transparent 3.7px),
        radial-gradient(circle at 51.2% 25.5%, rgba(215,176,255,.85) 0, rgba(215,176,255,.85) 1.7px, rgba(215,176,255,.16) 2.3px, transparent 8.7px),
        radial-gradient(circle at 42.1% 90.5%, rgba(223,171,255,.85) 0, rgba(223,171,255,.85) 1.4px, rgba(223,171,255,.16) 2.0px, transparent 6.9px),
        radial-gradient(circle at 92.9% 97.7%, rgba(220,195,255,.85) 0, rgba(220,195,255,.85) 0.8px, rgba(220,195,255,.16) 1.4px, transparent 4.3px),
        radial-gradient(circle at 65.4% 61.6%, rgba(203,218,255,.85) 0, rgba(203,218,255,.85) 0.8px, rgba(203,218,255,.16) 1.4px, transparent 3.9px);
    background-size: 100% 50%; background-repeat: repeat-y;
    animation: vanta-rise 90s linear infinite, vanta-twinkle 5s ease-in-out infinite alternate;
}
@keyframes vanta-nebula {
    from { transform: translate(-4%, 3%) scale(1) rotate(0deg); }
    to { transform: translate(5%, -4%) scale(1.12) rotate(6deg); }
}
@keyframes vanta-rise { from { transform: translateY(0); } to { transform: translateY(-50%); } }
@keyframes vanta-twinkle { from { opacity: 0.7; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { [class*="bg__"]::before, [class*="bg__"]::after, [class*="popout__"], [class*="menu__"], [class*="channelTextArea__"] { animation: none !important; } }

/* extra polish (matches Discord's class names by their stable first part, so it survives Discord's hash changes) */
[class*="button__"][class*="lookFilled__"][class*="colorBrand__"] { background-image: linear-gradient(135deg, #6d4cf0, #9b6bff) !important; box-shadow: 0 2px 14px rgba(123, 85, 242, 0.35); }
[class*="button__"][class*="lookFilled__"][class*="colorBrand__"]:hover { filter: brightness(1.12); }

[class*="channelTextArea__"] { border: 1px solid var(--input-border-default); border-radius: 10px; transition: border-color 0.15s, box-shadow 0.15s; }
[class*="channelTextArea__"]:focus-within { border-color: rgba(180, 139, 255, 0.7); box-shadow: 0 0 0 1px rgba(180, 139, 255, 0.25), 0 0 24px rgba(123, 85, 242, 0.28); }

[class*="mention__"] { background: rgba(123, 85, 242, 0.28) !important; color: #efe6ff !important; border-radius: 4px; }
[class*="mention__"]:hover { background: #7b55f2 !important; color: #ffffff !important; }

[class*="popout__"], [class*="tooltip__"], [class*="layer__"] > [class*="menu__"] {
    border: 1px solid rgba(180, 139, 255, 0.25) !important; box-shadow: 0 8px 32px rgba(40, 18, 110, 0.55) !important;
}

::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #5a3fc0, #3a2d66) !important; border-radius: 8px !important; border: 2px solid transparent !important; background-clip: padding-box !important; }
::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, #7b55f2, #5a3fc0) !important; background-clip: padding-box !important; }
::-webkit-scrollbar-track { background: transparent !important; border: 0 !important; }

/* smoother, livelier controls (hover effects only, so nothing moves until you touch it) */
[data-list-item-id^="guildsnav"] { transition: transform 0.18s ease, filter 0.18s ease; }
[data-list-item-id^="guildsnav"]:hover { transform: translateY(-2px) scale(1.06); filter: drop-shadow(0 0 9px rgba(160, 110, 255, 0.75)); }
[data-list-item-id^="channels___"], [data-list-item-id^="members___"], li[id^="chat-messages-"] { transition: background-color 0.18s ease; }
[class*="button__"][class*="lookFilled__"][class*="colorBrand__"] { background-size: 200% 100% !important; transition: background-position 0.4s ease, box-shadow 0.2s ease, transform 0.15s ease; }
[class*="button__"][class*="lookFilled__"][class*="colorBrand__"]:hover { background-position: 100% 0 !important; box-shadow: 0 4px 22px rgba(155, 107, 255, 0.55); transform: translateY(-1px); }
[class*="button__"][class*="lookFilled__"][class*="colorBrand__"]:active { transform: translateY(0); }
[class*="mention__"] { transition: background-color 0.15s ease, color 0.15s ease; }
[class*="sidebar__"] { border-right: 1px solid rgba(180, 139, 255, 0.10); }
[class*="popout__"], [class*="layer__"] > [class*="menu__"] { animation: vanta-pop 0.16s ease-out; }
@keyframes vanta-pop { from { opacity: 0; transform: translateY(4px) scale(0.98); } to { opacity: 1; transform: none; } }
[class*="channelTextArea__"]:focus-within { animation: vanta-pulse 2.8s ease-in-out infinite; }
@keyframes vanta-pulse { 0%, 100% { box-shadow: 0 0 0 1px rgba(180, 139, 255, 0.25), 0 0 18px rgba(123, 85, 242, 0.25); } 50% { box-shadow: 0 0 0 1px rgba(180, 139, 255, 0.45), 0 0 32px rgba(155, 107, 255, 0.45); } }

/* a sleeker font for servers, channels, members and headings (Bahnschrift comes with Windows 10/11, so nothing is downloaded;
   on a computer without it Discord's normal font is used) */
[data-list-item-id^="channels___"], [data-list-item-id^="members___"], [data-list-item-id^="guildsnav"],
[class*="sidebar__"] h2, [class*="sidebar__"] h3, [class*="categoryHeader"], [class*="headerContent__"], [class*="tooltip__"],
h1, h2, h3 {
    font-family: "Bahnschrift", "Segoe UI Variable Display", "gg sans", "Segoe UI", sans-serif !important;
    letter-spacing: 0.005em;
}
[class*="sidebar__"] h2, [class*="sidebar__"] h3, [class*="categoryHeader"] { text-transform: uppercase; letter-spacing: 0.09em; color: #c79bff; }

/* more colour: pink unread badges, glowing unread/selected markers, blue-violet channel icons */
[class*="numberBadge__"] { background: linear-gradient(135deg, #e24bd0, #9b4bff) !important; color: #fff !important; box-shadow: 0 0 10px rgba(226, 75, 208, 0.55); }
[class*="pill__"] > span, [class*="pill__"] [class*="item__"] { background: linear-gradient(180deg, #c79bff, #7b55f2) !important; box-shadow: 0 0 10px rgba(155, 107, 255, 0.8); }
[data-list-item-id^="channels___"] [class*="selected__"], [data-list-item-id^="channels___"][class*="selected__"] { background-image: linear-gradient(90deg, rgba(123, 85, 242, 0.38), rgba(226, 75, 208, 0.10)) !important; }

/* the Home button (top left, "your chats") shows the Vantacord VC logo instead of the Discord logo.
   The logo is a tiny picture stored inside this file (nothing is downloaded). */
[data-list-item-id="guildsnav___home"] [class*="childWrapper__"] {
    background-color: #1d1636 !important;
    background-image: url("data:image/png;base64,"), linear-gradient(135deg, #2a2145, #110d22) !important;
    background-size: 74% 74%, 100% 100% !important; background-position: center, center !important; background-repeat: no-repeat !important;
    box-shadow: 0 0 14px rgba(155, 107, 255, 0.45);
}
[data-list-item-id="guildsnav___home"] [class*="childWrapper__"] svg { opacity: 0 !important; }
[data-list-item-id="guildsnav___home"]:hover [class*="childWrapper__"] { background-color: #2a2145 !important; box-shadow: 0 0 20px rgba(180, 139, 255, 0.75); }

::selection { background: rgba(123, 85, 242, 0.55); color: #ffffff; }
