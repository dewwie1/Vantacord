/**
 * @name Vantacord Nebula
 * @author Vantacord
 * @version 1.0.0
 * @description Vantacord's purple space theme: the installer's deep purple with a starfield, drifting nebula glows and floating stardust, a sleek font for servers and channels, and purple lettering with pink and blue accents. Dark only, loads nothing from the internet.
 * @source https://vantacord.pages.dev
 */

/* The font for all the writing: Outfit (a modern rounded font by Rodrigo Fuenzalida, free under the SIL Open Font License),
   stored inside this file so nothing is downloaded and it works for everyone. Servers, channels and headings use a second font (below). */
@font-face {
    font-family: "Vantacord Outfit"; font-style: normal; font-weight: 300 700; font-display: swap;
    src: url("data:font/woff2;base64,") format("woff2");
}

.theme-dark, .theme-darker, .theme-midnight {
    /* backgrounds, darkest to lightest (the installer's #0a0716 -> #17122b -> #221a3d) */
    --background-base-lowest: rgba(10, 7, 22, 0.40);
    --background-base-lower: rgba(13, 10, 26, 0.30);
    --background-base-low: rgba(16, 12, 32, 0.22);
    --background-surface-high: #17122b;
    --background-surface-higher: #1d1636;
    --background-surface-highest: #221a3d;
    --background-secondary-alt: rgba(13, 10, 26, 0.30);
    --bg-surface-raised: #17122b;
    --chat-background: rgba(16, 12, 32, 0.22);
    --chat-background-default: rgba(16, 12, 32, 0.22);
    --channel-background-default: rgba(13, 10, 26, 0.30);
    --channeltextarea-background: #1d1636;
    --card-background-default: #17122b;
    --input-background-default: #0a0716;
    --app-frame-background: rgba(10, 7, 22, 0.40);

    /* hover / selected / pressed */
    --background-mod-subtle: rgba(180, 139, 255, 0.07);
    --background-mod-muted: rgba(180, 139, 255, 0.10);
    --background-mod-normal: rgba(180, 139, 255, 0.15);
    --background-mod-strong: rgba(180, 139, 255, 0.22);
    --interactive-background-hover: rgba(180, 139, 255, 0.12);
    --interactive-background-active: rgba(180, 139, 255, 0.20);
    --interactive-background-selected: rgba(180, 139, 255, 0.18);

    /* text: #ece6ff, muted #a79cd0, dim #8f84b5 */
    --text-strong: #f1e8ff;
    --text-default: #d4bfff;
    --text-muted: #a487ee;
    --text-subtle: #8a6fd0;
    --chat-text-muted: #a487ee;
    --channels-default: #c2a6ff;
    --channel-icon: #8fa6ff;
    --channel-text-area-placeholder: #8a6fd0;
    --input-placeholder-text-default: #8a6fd0;
    --interactive-text-default: #b497f5;
    --interactive-text-hover: #f3d6ff;
    --interactive-text-active: #ffffff;
    --interactive-icon-default: #b497f5;
    --interactive-icon-hover: #f3d6ff;
    --interactive-icon-active: #ffffff;
    --text-link: #d9a8ff;

    --font-primary: "Vantacord Outfit", "gg sans", "Segoe UI", sans-serif;
    --font-display: "Vantacord Outfit", "gg sans", "Segoe UI", sans-serif;

    /* the Vantacord purple */
    --background-brand: #7b55f2;
    --background-accent: #7b55f2;
    --text-brand: #c79bff;
    --background-feedback-notification: #e24bd0;
    --badge-notification-background: #e24bd0;
    --status-speaking: #7dffb3;
    --background-mod-subtle: rgba(160, 120, 255, 0.09);
    --interactive-accent-background-default: #7b55f2;
    --badge-primary-background: #7b55f2;
    --border-focus: #b48bff;
    --checkbox-background-active: #7b55f2;

    /* borders */
    --border-subtle: rgba(180, 139, 255, 0.12);
    --border-muted: rgba(180, 139, 255, 0.08);
    --border-normal: rgba(180, 139, 255, 0.22);
    --border-strong: rgba(180, 139, 255, 0.40);
    --chat-border: rgba(180, 139, 255, 0.12);
    --input-border-default: rgba(180, 139, 255, 0.25);
    --input-border-hover: rgba(180, 139, 255, 0.45);
    --card-border-default: rgba(180, 139, 255, 0.12);

    /* scrollbars */
    --scrollbar-thin-thumb: #3a2d66;
    --scrollbar-thin-track: transparent;
    --scrollbar-auto-thumb: #3a2d66;
    --scrollbar-auto-track: #100c20;
    --scrollbar-auto-scrollbar-color-thumb: #3a2d66;
    --scrollbar-auto-scrollbar-color-track: #100c20;
}

/* ---- The moving space background ----
   Discord paints its whole-window background on one layer that sits under every panel. The theme paints on that layer, and the
   panels above it are see-through, so the space shows through. Everything here is plain gradients (no pictures, no downloads).
   Layer 1: the still starfield + a quiet static glow. Layer 2 (::before): three nebula glows that drift slowly.
   Layer 3 (::after): little dust specks that twinkle and rise, like the Vantacord installer. */
[class*="bg__"] {
    overflow: hidden !important; isolation: isolate;
    background-color: #0a0716 !important;
    background-image:
        radial-gradient(ellipse 45% 40% at 12% 100%, rgba(110, 60, 230, 0.35), transparent 70%),
        radial-gradient(ellipse 40% 38% at 92% 95%, rgba(150, 70, 220, 0.28), transparent 70%),
        radial-gradient(circle at 62.3% 74.2%, rgba(255,210,255,0.35) 0, rgba(255,210,255,0.35) 1.6px, transparent 2.4px),
        radial-gradient(circle at 77.6% 24.9%, rgba(236,226,255,0.5) 0, rgba(236,226,255,0.5) 0.6px, transparent 1.4px),
        radial-gradient(circle at 37.2% 86.8%, rgba(200,170,255,0.35) 0, rgba(200,170,255,0.35) 1.2px, transparent 2.0px),
        radial-gradient(circle at 1.3% 21.7%, rgba(255,210,255,0.5) 0, rgba(255,210,255,0.5) 1px, transparent 1.8px),
        radial-gradient(circle at 16.0% 79.7%, rgba(200,170,255,0.9) 0, rgba(200,170,255,0.9) 0.8px, transparent 1.6px),
        radial-gradient(circle at 13.2% 97.2%, rgba(200,170,255,0.5) 0, rgba(200,170,255,0.5) 0.6px, transparent 1.4px),
        radial-gradient(circle at 96.0% 16.6%, rgba(170,190,255,0.7) 0, rgba(170,190,255,0.7) 0.8px, transparent 1.6px),
        radial-gradient(circle at 96.1% 53.9%, rgba(200,170,255,0.5) 0, rgba(200,170,255,0.5) 0.8px, transparent 1.6px),
        radial-gradient(circle at 96.7% 89.4%, rgba(170,190,255,0.35) 0, rgba(170,190,255,0.35) 1px, transparent 1.8px),
        radial-gradient(circle at 41.5% 93.6%, rgba(170,190,255,0.35) 0, rgba(170,190,255,0.35) 1px, transparent 1.8px),
        radial-gradient(circle at 30.1% 60.3%, rgba(236,226,255,0.7) 0, rgba(236,226,255,0.7) 0.6px, transparent 1.4px),
        radial-gradient(circle at 31.0% 81.9%, rgba(200,170,255,0.7) 0, rgba(200,170,255,0.7) 1.2px, transparent 2.0px),
        radial-gradient(circle at 48.1% 70.5%, rgba(236,226,255,0.7) 0, rgba(236,226,255,0.7) 0.6px, transparent 1.4px),
        radial-gradient(circle at 94.9% 35.8%, rgba(255,210,255,0.35) 0, rgba(255,210,255,0.35) 1.2px, transparent 2.0px),
        radial-gradient(circle at 36.6% 57.9%, rgba(236,226,255,0.9) 0, rgba(236,226,255,0.9) 0.6px, transparent 1.4px),
        radial-gradient(circle at 70.8% 62.4%, rgba(200,170,255,0.35) 0, rgba(200,170,255,0.35) 0.8px, transparent 1.6px),
        radial-gradient(circle at 93.0% 94.2%, rgba(170,190,255,0.7) 0, rgba(170,190,255,0.7) 1px, transparent 1.8px),
        radial-gradient(circle at 77.6% 10.8%, rgba(236,226,255,0.7) 0, rgba(236,226,255,0.7) 1px, transparent 1.8px),
        radial-gradient(circle at 43.3% 97.8%, rgba(170,190,255,0.7) 0, rgba(170,190,255,0.7) 0.8px, transparent 1.6px),
        radial-gradient(circle at 91.8% 34.0%, rgba(170,190,255,0.35) 0, rgba(170,190,255,0.35) 1.6px, transparent 2.4px),
        radial-gradient(circle at 68.6% 30.6%, rgba(170,190,255,0.5) 0, rgba(170,190,255,0.5) 0.6px, transparent 1.4px),
        radial-gradient(circle at 99.7% 16.2%, rgba(255,210,255,0.35) 0, rgba(255,210,255,0.35) 0.6px, transparent 1.4px),
        radial-gradient(circle at 3.2% 74.1%, rgba(255,210,255,0.7) 0, rgba(255,210,255,0.7) 1px, transparent 1.8px),
        radial-gradient(circle at 65.1% 14.6%, rgba(170,190,255,0.9) 0, rgba(170,190,255,0.9) 0.6px, transparent 1.4px),
