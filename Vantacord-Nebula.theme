        radial-gradient(circle at 96.8% 60.9%, rgba(255,210,255,0.35) 0, rgba(255,210,255,0.35) 1px, transparent 1.8px),
        radial-gradient(circle at 10.8% 56.6%, rgba(170,190,255,0.5) 0, rgba(170,190,255,0.5) 1.6px, transparent 2.4px),
        radial-gradient(circle at 62.9% 89.1%, rgba(255,210,255,0.9) 0, rgba(255,210,255,0.9) 1.2px, transparent 2.0px),
        radial-gradient(circle at 97.7% 49.3%, rgba(255,210,255,0.9) 0, rgba(255,210,255,0.9) 1.2px, transparent 2.0px),
        radial-gradient(circle at 96.1% 91.4%, rgba(170,190,255,0.7) 0, rgba(170,190,255,0.7) 1.6px, transparent 2.4px),
        radial-gradient(circle at 49.6% 41.5%, rgba(255,210,255,0.7) 0, rgba(255,210,255,0.7) 1px, transparent 1.8px),
