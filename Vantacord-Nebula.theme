    background-repeat: no-repeat !important;
}
[class*="bg__"]::before, [class*="bg__"]::after {
    content: ""; position: absolute; pointer-events: none; will-change: transform;
}
[class*="bg__"]::before {
    left: -25%; top: -25%; width: 150%; height: 150%;
    background:
        radial-gradient(circle at 18% 82%, rgba(110, 60, 230, 0.70), transparent 38%),
        radial-gradient(circle at 82% 78%, rgba(150, 70, 220, 0.58), transparent 36%),
        radial-gradient(circle at 50% 12%, rgba(70, 90, 235, 0.48), transparent 34%);
    animation: vanta-nebula 48s ease-in-out infinite alternate;
}
[class*="bg__"]::after {
    left: 0; top: 0; width: 100%; height: 200%;
    background-image:
        radial-gradient(circle at 45.2% 56.0%, rgba(219,188,255,.85) 0, rgba(219,188,255,.85) 2.0px, rgba(219,188,255,.16) 2.6px, transparent 10.1px),
        radial-gradient(circle at 50.8% 58.7%, rgba(222,190,255,.85) 0, rgba(222,190,255,.85) 0.9px, rgba(222,190,255,.16) 1.5px, transparent 4.7px),
        radial-gradient(circle at 63.0% 79.3%, rgba(209,169,255,.85) 0, rgba(209,169,255,.85) 0.8px, rgba(209,169,255,.16) 1.4px, transparent 4.0px),
        radial-gradient(circle at 9.1% 81.0%, rgba(192,198,255,.85) 0, rgba(192,198,255,.85) 1.7px, rgba(192,198,255,.16) 2.3px, transparent 8.4px),
        radial-gradient(circle at 98.2% 96.5%, rgba(229,201,255,.85) 0, rgba(229,201,255,.85) 1.6px, rgba(229,201,255,.16) 2.2px, transparent 8.1px),
        radial-gradient(circle at 15.7% 1.5%, rgba(193,162,255,.85) 0, rgba(193,162,255,.85) 1.4px, rgba(193,162,255,.16) 2.0px, transparent 7.2px),
        radial-gradient(circle at 19.0% 24.2%, rgba(219,180,255,.85) 0, rgba(219,180,255,.85) 0.7px, rgba(219,180,255,.16) 1.3px, transparent 3.6px),
        radial-gradient(circle at 44.1% 84.2%, rgba(230,178,255,.85) 0, rgba(230,178,255,.85) 1.4px, rgba(230,178,255,.16) 2.0px, transparent 7.1px),
        radial-gradient(circle at 50.0% 66.2%, rgba(207,186,255,.85) 0, rgba(207,186,255,.85) 1.3px, rgba(207,186,255,.16) 1.9px, transparent 6.7px),
        radial-gradient(circle at 99.8% 99.6%, rgba(235,176,255,.85) 0, rgba(235,176,255,.85) 1.9px, rgba(235,176,255,.16) 2.5px, transparent 9.5px),
        radial-gradient(circle at 31.5% 23.0%, rgba(194,196,255,.85) 0, rgba(194,196,255,.85) 1.1px, rgba(194,196,255,.16) 1.7px, transparent 5.5px),
