/**
 * @name Vantacord Nebula
 * @author Vantacord
 * @version 1.0.0
 * @description Vantacord's purple space theme: the installer's deep purple with a starfield, drifting nebula glows and floating stardust, a sleek font for servers and channels, and purple lettering with pink and blue accents. Dark only, loads nothing from the internet.
 * @source https://vantacord.pages.dev
 */

.theme-dark, .theme-darker, .theme-midnight {
    /* backgrounds, darkest to lightest (the installer's #0a0716 -> #17122b -> #221a3d) */
    --background-base-lowest: rgba(10, 7, 22, 0.50);
    --background-base-lower: rgba(13, 10, 26, 0.38);
    --background-base-low: rgba(16, 12, 32, 0.30);
    --background-surface-high: #17122b;
    --background-surface-higher: #1d1636;
    --background-surface-highest: #221a3d;
    --background-secondary-alt: rgba(13, 10, 26, 0.38);
    --bg-surface-raised: #17122b;
    --chat-background: rgba(16, 12, 32, 0.30);
    --chat-background-default: rgba(16, 12, 32, 0.30);
    --channel-background-default: rgba(13, 10, 26, 0.38);
    --channeltextarea-background: #1d1636;
    --card-background-default: #17122b;
    --input-background-default: #0a0716;
    --app-frame-background: rgba(10, 7, 22, 0.50);

    /* hover / selected / pressed */
    --background-mod-subtle: rgba(180, 139, 255, 0.07);
    --background-mod-muted: rgba(180, 139, 255, 0.10);
    --background-mod-normal: rgba(180, 139, 255, 0.15);
    --background-mod-strong: rgba(180, 139, 255, 0.22);
    --interactive-background-hover: rgba(180, 139, 255, 0.12);
    --interactive-background-active: rgba(180, 139, 255, 0.20);
    --interactive-background-selected: rgba(180, 139, 255, 0.18);

    /* text: #ece6ff, muted #a79cd0, dim #8f84b5 */
    --text-strong: #f1e8ff;
    --text-default: #d4bfff;
    --text-muted: #a487ee;
    --text-subtle: #8a6fd0;
    --chat-text-muted: #a487ee;
    --channels-default: #c2a6ff;
    --channel-icon: #8fa6ff;
    --channel-text-area-placeholder: #8a6fd0;
    --input-placeholder-text-default: #8a6fd0;
    --interactive-text-default: #b497f5;
    --interactive-text-hover: #f3d6ff;
    --interactive-text-active: #ffffff;
    --interactive-icon-default: #b497f5;
    --interactive-icon-hover: #f3d6ff;
    --interactive-icon-active: #ffffff;
    --text-link: #d9a8ff;

    /* the Vantacord purple */
    --background-brand: #7b55f2;
    --background-accent: #7b55f2;
    --text-brand: #c79bff;
    --background-feedback-notification: #e24bd0;
    --badge-notification-background: #e24bd0;
    --status-speaking: #7dffb3;
    --background-mod-subtle: rgba(160, 120, 255, 0.09);
    --interactive-accent-background-default: #7b55f2;
    --badge-primary-background: #7b55f2;
    --border-focus: #b48bff;
    --checkbox-background-active: #7b55f2;

    /* borders */
    --border-subtle: rgba(180, 139, 255, 0.12);
    --border-muted: rgba(180, 139, 255, 0.08);
    --border-normal: rgba(180, 139, 255, 0.22);
    --border-strong: rgba(180, 139, 255, 0.40);
    --chat-border: rgba(180, 139, 255, 0.12);
    --input-border-default: rgba(180, 139, 255, 0.25);
    --input-border-hover: rgba(180, 139, 255, 0.45);
    --card-border-default: rgba(180, 139, 255, 0.12);

    /* scrollbars */
    --scrollbar-thin-thumb: #3a2d66;
    --scrollbar-thin-track: transparent;
    --scrollbar-auto-thumb: #3a2d66;
    --scrollbar-auto-track: #100c20;
    --scrollbar-auto-scrollbar-color-thumb: #3a2d66;
    --scrollbar-auto-scrollbar-color-track: #100c20;
}

/* The moving background from the installer: three soft purple glows drifting slowly behind everything, plus the floating dust below.
   Still gradients that only slide (no blur, no pictures, nothing downloaded), so it stays light on speed. */
/* a still starfield under everything (on the page itself, so it costs nothing to draw) */
html { background: #0a0716; background-image:
        radial-gradient(circle at 62.3% 74.2%, rgba(255,210,255,0.35) 0, rgba(255,210,255,0.35) 1.6px, transparent 2.4px),
